# ─── Next.js (.env.local locally; Vercel → Project → Settings → Environment Variables) ───

# Written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Same as NEXT_PUBLIC_CONVEX_URL but ending in .convex.site (Better Auth runs there)
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public site URL (used for SEO, sitemap and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Convex (set with `npx convex env set NAME value`, NOT in .env.local) ───
#
# OWNER_EMAILS=sonia@example.com            # who can use /dashboard (comma-separated)
# BETTER_AUTH_SECRET=$(openssl rand -base64 32)
# SITE_URL=http://localhost:3000            # auth base URL, emails + Paystack callback
# PAYSTACK_SECRET_KEY=sk_test_xxx           # Paystack → Settings → API Keys & Webhooks
# RESEND_API_KEY=re_xxx                     # optional; emails are logged and skipped without it
# EMAIL_FROM="Sonia Brown <bookings@yourdomain.com>"
